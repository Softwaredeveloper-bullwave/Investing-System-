SECRET_KEY=change-me-to-a-random-secret-key

DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=bullwave_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Real-time market data — Kotak Neo Trade API (recommended)
# Kotak Neo app → More → TradeAPI → API Dashboard
# IMPORTANT: use **Access Token** here — NOT the Consumer Key / Client ID
KOTAK_NEO_ACCESS_TOKEN=
KOTAK_NEO_BASE_URL=https://mis.kotaksecurities.com
KOTAK_NEO_QUOTE_CACHE_SECONDS=15
KOTAK_NEO_UNIVERSE_CACHE_SECONDS=86400
KOTAK_NEO_BATCH_SIZE=50
MARKET_DATA_PROVIDER=kotak_neo

# Optional fallbacks
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

MARKET_QUOTE_CACHE_SECONDS=15
MARKET_UNIVERSE_CACHE_SECONDS=86400

# AI — OpenAI (chat + voice). Get key: https://platform.openai.com/api-keys
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenAI voice (TTS + Whisper STT) — uses same OPENAI_API_KEY
AI_VOICE_PROVIDER=openai
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_SPEED=1.0
OPENAI_STT_MODEL=whisper-1
OPENAI_STT_ENABLED=False

AI_TEMPERATURE=0.7
AI_MAX_TOKENS=350
AI_REQUEST_TIMEOUT=30

# Ollama fallback (set AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048

# ── SMS OTP (production) ──
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms

# ── Payments — Razorpay ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Verification — Cashfree Secure ID ──
# https://merchant.cashfree.com/verificationsuite/developers/api-keys
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=TEST
CASHFREE_API_VERSION=2023-12-18

# ── Verification — Eko PAN Lite (paste your keys here) ──
# Docs: https://developers.eko.in/reference/pan-lite
# Get UAT/sandbox test credentials: https://developers.eko.in/docs/platform-credentials
# Production keys are emailed to you by Eko after KYC + UAT sign-off.
# When these three are set, PAN verification uses Eko instead of Cashfree.
EKO_DEVELOPER_KEY=
EKO_KEY=
EKO_INITIATOR_ID=
EKO_USER_CODE=
EKO_ENV=sandbox
# If you get "No mapping rule matched" / HTTP 404 from Eko, try v2 or v1 here —
# per Eko's own docs, that error is usually fixed by swapping the API version.
EKO_API_VERSION=v3
# Leave EKO_BASE_URL unset unless Eko support tells you otherwise — the code
# defaults to https://api.eko.in:25002 (prod) / https://staging.eko.in:25004
# (sandbox), which matches Eko's own docs exactly:
# {base}/ekoapi/{version}/tools/kyc/pan-lite. Do NOT append a bank/partner
# path segment (e.g. "/ekoicici") here — that also causes
# "No mapping rule matched", since the combined URL won't match any route
# Eko has registered for the PAN Lite tool.
# EKO_BASE_URL=

# ── Compliance ──
KYC_AUTO_APPROVE=False
REFERRAL_REWARD_AMOUNT=100
OTP_EXPIRY_MINUTES=10
NEWS_CACHE_MINUTES=15

ADMIN_KYC_EMAIL=
KYC_EMAIL_REVIEWER_PHONE=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Public URL for KYC email approve/reject links (use ngrok if testing from Gmail on localhost)
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# Email — use Gmail SMTP (Brevo IP-blocked, SendGrid key invalid)
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# SendGrid disabled — key contained invalid characters; use SMTP above
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

ADMIN_FNO_EMAIL=

# ElevenLabs — disabled (using OpenAI voice instead). Leave empty.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=
